# Secrets -- NEVER commit this, it contains your private Lichess API token
.streamlit/secrets.toml

# Large data files -- these are regenerated by running the scripts,
# not needed in the repo itself (and PGN/CSV files here are too large
# to be sensible to store in git)
sample_games.pgn
features_dataset.csv
features_dataset_v2.csv
player_features.csv
player_features_v2.csv
games_summary.csv

# Stockfish engine binary -- download separately (see README), don't
# commit a 75MB+ third-party binary to your own repo
stockfish-windows-x86-64-avx2/

# Python cache files
__pycache__/
*.pyc

# OS-generated files
.DS_Store
Thumbs.db
